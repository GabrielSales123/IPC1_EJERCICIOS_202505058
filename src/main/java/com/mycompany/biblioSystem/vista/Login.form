    <Component class="javax.swing.JPasswordField" name="logPassword">
      <Properties>
        <Property name="text" type="java.lang.String" editor="org.netbeans.modules.form.RADConnectionPropertyEditor">
          <Connection code="&quot;Ingrese su contrase&#xf1;a&quot;" type="code"/>
